# Copy this file to .env and fill it in (for running on your own computer).
# On GitHub, the same values are stored as repository secrets instead.

MAIL_TO=recipient@example.com
MAIL_FROM="Sender Name <you@gmail.com>"

# Gmail: use an App Password, not your normal password.
# (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password

# Names shown on the invoice
CUSTOMER_NAME=Customer Name
SELLER_NAME=Your Store

# Schedule: every day at SEND_HOUR:SEND_MINUTE in TIMEZONE
TIMEZONE=Asia/Beirut
SEND_HOUR=9
SEND_MINUTE=0

PORT=3000
